// MyCabas - Prisma Schema
// Marketplace pour marchés locaux

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  CLIENT
  VENDOR
  ADMIN
}

enum Day {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

enum PaymentMethod {
  CASH        // Espèces
  CARD        // Carte bancaire
  CHECK       // Chèque
  TRANSFER    // Virement
}

enum VendorLabel {
  HOME_MADE     // Fait maison
  BIO           // Agriculture biologique
  LOCAL         // Producteur local
  ARTISAN       // Artisan
  FERMIER       // Producteur fermier
  AOC_AOP       // Appellation d'origine
  LABEL_ROUGE   // Label Rouge
  FAIR_TRADE    // Commerce équitable
  NO_ICE        // Aucun produit surgelé
}

enum OrderStatus {
  PENDING_PAYMENT   // En attente d'autorisation carte
  AUTHORIZED        // Carte pré-autorisée, en attente confirmation vendor
  CONFIRMED         // Vendor a confirmé la commande
  ADJUSTED          // Vendor a ajusté les quantités/prix
  CAPTURED          // Paiement capturé
  PICKED_UP         // Client a récupéré au marché
  CANCELLED         // Annulé (autorisation relâchée)
  EXPIRED           // Expiré (vendor n'a pas confirmé avant le marché)
  REFUNDED          // Remboursé après capture
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  CANCELLED
  FAILED
  REFUNDED
}

enum MarketStatus {
  ACTIVE   // Marché validé, visible par tous
  PENDING  // En attente de validation admin
  REJECTED // Rejeté par l'admin
}

enum ConversationStatus {
  OPEN     // Conversation ouverte
  CLOSED   // Clôturée par l'admin
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  role          Role      @default(CLIENT)
  avatarUrl     String?

  // Relations
  address         Address?
  vendor          Vendor?
  accounts        Account[]
  sessions        Session[]
  favoriteMarkets FavoriteMarket[]

  cart            Cart?
  orders          Order[]
  sentMessages    Message[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

// ============================================
// ADDRESS
// ============================================

model Address {
  id        String  @id @default(cuid())
  street    String
  zip       String
  town      String
  country   String  @default("France")

  // Relation
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// ============================================
// VENDOR
// ============================================

model Vendor {
  id            String   @id @default(cuid())
  stallName     String   // Nom du stand/commerce
  siret         String   @unique
  companyName   String   // Nom complet de l'entreprise (API gouv)
  description   String?  @db.Text

  // Informations de contact professionnel
  phone         String?           // Téléphone professionnel
  email         String?           // Email de contact pro
  logoUrl       String?           // Logo/image de la boutique
  website       String?           // Site web
  socialLinks   Json?             // { instagram?: string, facebook?: string, tiktok?: string }

  // Labels et paiements
  paymentMethods PaymentMethod[]  // Modes de paiement acceptés
  labels         VendorLabel[]    // Certifications/labels du commerçant

  // Informations bancaires (chiffrées)
  encryptedIban       String?    // IBAN chiffré avec AES-256-GCM
  encryptedBic        String?    // BIC/SWIFT chiffré
  encryptedBankHolder String?    // Titulaire du compte chiffré
  bankInfoUpdatedAt   DateTime?  // Date de dernière mise à jour des infos bancaires

  // Stripe Connect
  stripeConnectAccountId    String?   @unique  // ID du compte Stripe Express (acct_...)
  stripeOnboardingComplete  Boolean   @default(false) // Onboarding terminé et charges activées

  // Relation User
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  products          Product[]
  marketVendors     MarketVendor[]
  orderItems        OrderItem[]
  submittedMarkets  Market[]       @relation("SubmittedMarkets")
  settings          VendorSettings?
  conversations     Conversation[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("vendors")
}

model VendorSettings {
  id                    String    @id @default(cuid())

  // Notifications
  notifPush             Boolean   @default(true)
  notifEmail            Boolean   @default(true)
  notifSms              Boolean   @default(false)

  // Commandes
  autoConfirm           Boolean   @default(false)
  deadlineDaysBeforeDay Int       @default(1)   // 0 = jour même, 1 = veille, etc.
  deadlineHour          Int       @default(19)  // 0–23
  deadlineMinute        Int       @default(0)   // 0, 15, 30, 45

  // Mode vacances
  vacationMode          Boolean   @default(false)
  vacationStart         DateTime?
  vacationEnd           DateTime?

  // Frais bancaires Stripe
  stripeFeePaidBy       String    @default("VENDOR") // "VENDOR" | "CUSTOMER"

  vendor                Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId              String    @unique

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("vendor_settings")
}

// ============================================
// MARKET
// ============================================

model Market {
  id            String          @id @default(cuid())
  name          String
  address       String
  zip           String
  town          String
  lat           Float
  lng           Float

  // Statut de validation
  status              MarketStatus @default(ACTIVE)
  submittedByVendorId String?      // null = ajouté par admin
  rejectionReason     String?      @db.Text // Raison du rejet par l'admin

  // Relations
  openings        MarketOpening[]
  marketVendors   MarketVendor[]
  productPrices   ProductPrice[]
  productStocks   ProductStock[]
  favoritedBy     FavoriteMarket[]
  carts           Cart[]
  orders          Order[]
  submittedBy     Vendor?          @relation("SubmittedMarkets", fields: [submittedByVendorId], references: [id], onDelete: SetNull)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([town])
  @@index([zip])
  @@index([lat, lng])
  @@index([status])
  @@map("markets")
}

// Table de jonction User <-> Market (favoris par jour)
model FavoriteMarket {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketId  String
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  day       Day      // Jour spécifique (LUNDI, MARDI, etc.)

  createdAt DateTime @default(now())

  @@unique([userId, marketId, day])
  @@map("favorite_markets")
}

model MarketOpening {
  id        String  @id @default(cuid())
  day       Day
  start     String  // Format "HH:MM"
  end       String  // Format "HH:MM"

  // Relation
  marketId  String
  market    Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@map("market_openings")
}

// Table de jonction Vendor <-> Market
model MarketVendor {
  id        String   @id @default(cuid())

  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  marketId  String
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  days      Day[]    // Jours où le vendor est présent sur ce marché

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, marketId])
  @@map("market_vendors")
}

// ============================================
// CATEGORY
// ============================================

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?   // Nom de l'icône (ex: "apple", "fish", etc.)

  // Relations
  products    Product[]

  createdAt   DateTime  @default(now())

  @@map("categories")
}

// ============================================
// PRODUCT
// ============================================

model Product {
  id              String         @id @default(cuid())
  name            String
  genericName     String?                             // Auto-généré par IA — recherche uniquement, invisible vendeur
  description     String?        @db.Text
  imageUrl        String?
  unit            String         @default("kg") // kg, pièce, botte, etc.
  minOrderQty     Float          @default(1)    // Dérivé automatiquement selon le type d'unité
  stepIncrement   Float          @default(1)    // Dérivé automatiquement selon le type d'unité
  basePrice       Float          // Prix de référence

  // Gestion des quantités simplifiée
  canSellByPiece       Boolean  @default(false) // Unité continue vendable à la pièce (ex: pommes au kg)
  approxWeightPerPiece Float?                   // Poids/volume approx d'une pièce dans l'unité du produit
  pricePerPiece        Float?                   // Prix affiché à la pièce (mode "carrot")

  isOrganic       Boolean        @default(false) // Produit bio
  isLocal         Boolean        @default(false) // Produit local
  isActive        Boolean        @default(true)  // Produit actif/inactif globalement

  // Relation Vendor
  vendorId        String
  vendor          Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Relation Category
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])

  // Prix et stocks par marché
  pricesByMarket  ProductPrice[]
  stocksByMarket  ProductStock[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("products")
}

// Prix d'un produit pour un marché spécifique
model ProductPrice {
  id          String  @id @default(cuid())
  price       Float?  // null = utiliser basePrice du produit
  isAvailable Boolean @default(true) // Disponible sur ce marché

  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  marketId    String
  market      Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([productId, marketId])
  @@map("product_prices")
}

// Stock d'un produit pour un marché spécifique
model ProductStock {
  id          String  @id @default(cuid())
  quantity    Int?    // null = stock illimité
  isUnlimited Boolean @default(true) // Stock illimité par défaut

  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  marketId    String
  market      Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([productId, marketId])
  @@map("product_stocks")
}

// ============================================
// CART (Panier)
// ============================================

model Cart {
  id        String     @id @default(cuid())

  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Marché associé au panier (un panier = un marché + un jour)
  marketId  String?
  market    Market?    @relation(fields: [marketId], references: [id], onDelete: SetNull)
  marketDay Day?       // Jour du marché sélectionné

  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  quantity  Float    @default(1) // Float pour supporter les quantités en kg

  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId]) // Un produit ne peut apparaître qu'une fois par panier
  @@map("cart_items")
}

// ============================================
// ORDER (Commande)
// ============================================

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique  // Format: MYC-YYYYMMDD-XXXX

  status            OrderStatus @default(PENDING_PAYMENT)

  // Client
  userId            String
  user              User        @relation(fields: [userId], references: [id])

  // Marché et jour
  marketId          String
  market            Market      @relation(fields: [marketId], references: [id])
  marketDay         Day         // Jour du marché (LUNDI, MARDI, etc.)
  marketDate        DateTime    // Date exacte du jour de marché

  // Montants en euros (Float, cohérent avec le reste du schema)
  subtotalEuros     Float       // Somme des items avant commission
  totalEuros        Float       // Montant payé par le client (= subtotalEuros)

  // Commissions par vendor (JSON: { vendorId: commissionEuros })
  commissionsByVendor Json      @default("{}")

  // Montants ajustés par le vendor
  adjustedSubtotalEuros Float?  // Après ajustement vendor
  adjustedTotalEuros    Float?
  vendorNote            String? @db.Text // Note du vendor (ex: ajustement de poids)

  // Deadline de capture (début du marché)
  captureDeadline   DateTime

  // Timestamps
  confirmedAt       DateTime?
  capturedAt        DateTime?
  cancelledAt       DateTime?
  pickedUpAt        DateTime?

  // Relations
  items             OrderItem[]
  payment           Payment?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([marketId, marketDate])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                String    @id @default(cuid())

  // Snapshot du produit au moment de la commande
  productName       String
  productUnit       String    // kg, pièce, botte...
  productImageUrl   String?
  unitPriceEuros    Float     // Prix résolu au checkout (ProductPrice.price ?? basePrice)
  quantity          Float     // Quantité commandée
  totalEuros        Float     // unitPriceEuros * quantity

  // Ajustement vendor
  adjustedQuantity    Float?
  adjustedTotalEuros  Float?

  // Référence produit (pour lien, pas pour le prix) — nullable : si le produit est supprimé, le snapshot reste intact
  productId         String?
  product           Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Référence vendor (pour grouper et calculer les commissions/transfers)
  vendorId          String
  vendor            Vendor    @relation(fields: [vendorId], references: [id])

  // Commande parente
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@map("order_items")
}

// ============================================
// PAYMENT (Paiement Stripe)
// ============================================

model Payment {
  id                      String        @id @default(cuid())
  status                  PaymentStatus @default(PENDING)

  // Stripe
  stripePaymentIntentId   String        @unique
  stripeClientSecret      String?       // Temporaire, pour le frontend
  amountCents             Int           // Montant en centimes pour Stripe
  currency                String        @default("eur")

  // Commission totale (somme de toutes les commissions vendors)
  applicationFeeCents     Int?

  // Timestamps Stripe
  authorizedAt            DateTime?
  capturedAt              DateTime?
  cancelledAt             DateTime?
  failedAt                DateTime?

  // Relation 1:1 avec Order
  orderId                 String        @unique
  order                   Order         @relation(fields: [orderId], references: [id])

  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([stripePaymentIntentId])
  @@map("payments")
}

// ============================================
// MESSAGERIE INTERNE (Vendor <-> Admin)
// ============================================

model Conversation {
  id        String             @id @default(cuid())
  subject   String             // Objet de la conversation

  status    ConversationStatus @default(OPEN)

  // Vendor initiateur
  vendorId  String
  vendor    Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  messages  Message[]

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([vendorId])
  @@index([status])
  @@map("conversations")
}

model Message {
  id              String       @id @default(cuid())
  content         String       @db.Text

  // Expéditeur
  senderId        String
  sender          User         @relation(fields: [senderId], references: [id])

  // Conversation parente
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Lecture
  readAt          DateTime?    // null = non lu

  createdAt       DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}
